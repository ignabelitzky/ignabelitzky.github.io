---
import { dacor, experiencePeriod } from '../data/experience.ts';
import { getCollection } from 'astro:content';
import { ui } from '../i18n/ui.ts';
import { routePath, type Locale, type RouteKey } from '../i18n/routes.ts';
import { site } from '../data/site.ts';
import ActionLink from './ActionLink.astro';
import ContactStrip from './ContactStrip.astro';
import ProjectCard from './ProjectCard.astro';
import GalleryView from './GalleryView.astro';
import AboutView from './AboutView.astro';
import WritingView from './WritingView.astro';
import ResearchCallout from './ResearchCallout.astro';
import { editorial } from '../i18n/editorial.ts';
import { detailPath } from '../i18n/routes.ts';
interface Props {
  locale: Locale;
  route: RouteKey;
}
const { locale, route } = Astro.props;
const copy = ui[locale];
const projects =
  route === 'home' || route === 'projects'
    ? (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order)
    : [];
const featured = projects.filter((project) => project.data.featured);
const first = featured[0];
const categories = ['desktop', 'graphics', 'tools', 'web', 'experiments', 'research'] as const;
---

{route === 'home' && (
  <>
    <section class="hero">
      <p class="eyebrow">
        {site.name} · {site.title}
      </p>
      <h1>{copy.hero}</h1>
      <p class="intro">{copy.introduction}</p>
      <div class="actions">
        <ActionLink href={routePath(locale, 'projects')}>{copy.explore}</ActionLink>
        <ActionLink href={routePath(locale, 'contact')} secondary>
          {copy.touch}
        </ActionLink>
      </div>
    </section>
    <section class="section">
      <div class="section-head">
        <h2>{copy.selected}</h2>
        <a class="text-link" href={routePath(locale, 'projects')}>
          {copy.all} <span aria-hidden="true">→</span>
        </a>
      </div>
      {first && <ProjectCard project={first} locale={locale} featured />}
      <div class="grid-two">
        {featured.slice(1).map((project) => (
          <ProjectCard project={project} locale={locale} />
        ))}
      </div>
    </section>
    <section class="section dacor-preview" aria-labelledby="dacor-preview-title">
      <div>
        <p class="eyebrow">{experiencePeriod(locale)}</p>
        <h2 id="dacor-preview-title">{dacor.translations[locale].homeTitle}</h2>
        <p class="muted">{dacor.translations[locale].homeText}</p>
      </div>
      <a class="text-link" href={detailPath(locale, 'projects', dacor.caseStudySlug)}>
        {editorial[locale].detail} <span aria-hidden="true">→</span>
      </a>
    </section>
    <section class="section about-row">
      <div>
        <h2>{copy.aboutHeading}</h2>
        <p class="muted">{copy.biography}</p>
        <a class="text-link" href={routePath(locale, 'about')}>
          {copy.more} <span aria-hidden="true">→</span>
        </a>
      </div>
      <div>
        <h2>{copy.interests}</h2>
        <ul class="interest-list">
          {copy.interestItems.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
    </section>
    <section class="section">
      <ResearchCallout locale={locale} />
    </section>
    <ContactStrip locale={locale} />
  </>
)}
{route === 'projects' && (
  <>
    <section class="page-intro">
      <h1>{copy.titles.projects}</h1>
      <p>{editorial[locale].projects_intro}</p>
      <nav
        class="jump-links"
        aria-label={locale === 'en' ? 'Project categories' : 'Categorías de proyectos'}
      >
        {categories.map((category) => (
          <a href={`#${category}`}>{copy.categories[category]}</a>
        ))}
        <a href={routePath(locale, 'gallery')}>{copy.nav.gallery}</a>
      </nav>
    </section>
    {categories.map((category) => (
      <section class="section" id={category}>
        <h2>{copy.categories[category]}</h2>
        {projects
          .filter((p) => p.data.category === category)
          .map((p) => (
            <article class="project-row">
              <span class="project-number" aria-hidden="true">
                {String(p.data.order).padStart(2, '0')}
              </span>
              <div>
                <h3>
                  <a href={detailPath(locale, 'projects', p.data.slug)}>{p.data.name}</a>
                </h3>
                <p>{p.data.translations[locale].summary}</p>
                <a
                  class="text-link"
                  href={detailPath(locale, 'projects', p.data.slug)}
                  aria-label={`${editorial[locale].detail} — ${p.data.name}`}
                >
                  {editorial[locale].detail} <span aria-hidden="true">→</span>
                </a>
                <ul class="tags" aria-label={locale === 'en' ? 'Technologies' : 'Tecnologías'}>
                  {p.data.technologies.map((t) => (
                    <li class="tag">{t}</li>
                  ))}
                </ul>
              </div>
              <a class="source" href={p.data.source} aria-label={`${copy.source} — ${p.data.name}`}>
                {copy.source} <span aria-hidden="true">↗</span>
              </a>
            </article>
          ))}
      </section>
    ))}
    <ContactStrip locale={locale} />
  </>
)}
{route === 'gallery' && <GalleryView locale={locale} />}
{route === 'about' && <AboutView locale={locale} />}
{route === 'writing' && <WritingView locale={locale} />}
{route === 'contact' && (
  <>
    <section class="page-intro">
      <p class="eyebrow">{copy.touch}</p>
      <h1>{copy.contactHeading}</h1>
      <p>{copy.contactText}</p>
    </section>
    <section class="contact-page">
      <h2>{locale === 'en' ? 'Email' : 'Correo'}</h2>
      <p class="muted">{copy.emailText}</p>
      <a class="email" href={`mailto:${site.email}`}>
        {site.email}
      </a>
      <div class="contact-options">
        <h2 class="contact-heading">
          <svg
            width="22"
            height="22"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            focusable="false"
          >
            <path d="M9 19c-4.3 1.3-4.3-2.2-6-2.7M15 22v-3.9c0-1.1-.1-1.8-.6-2.4 2.6-.3 5.4-1.3 5.4-6A4.7 4.7 0 0 0 18.5 6c.1-.3.6-1.7-.1-3.5 0 0-1.1-.3-3.6 1.4a12.3 12.3 0 0 0-6.6 0C5.7 2.2 4.6 2.5 4.6 2.5 3.9 4.3 4.4 5.7 4.5 6a4.7 4.7 0 0 0-1.3 3.7c0 4.7 2.8 5.7 5.4 6-.5.6-.6 1.3-.6 2.4V22" />
          </svg>
          GitHub
        </h2>
        <p class="muted">{copy.githubText}</p>
        <a class="text-link" href={site.github}>
          github.com/ignabelitzky <span aria-hidden="true">↗</span>
        </a>
      </div>
      <div class="contact-options">
        <h2 class="contact-heading">
          <svg
            width="22"
            height="22"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            focusable="false"
          >
            <rect x="3" y="3" width="18" height="18" rx="2" />
            <path d="M7.5 10.5v7M11.5 17.5v-7m0 3a3 3 0 0 1 6 0v4" />
            <circle cx="7.5" cy="7" r=".75" fill="currentColor" stroke="none" />
          </svg>
          LinkedIn
        </h2>
        <p class="muted">{copy.linkedinText}</p>
        <a class="text-link" href={site.linkedin}>
          linkedin.com/in/ignacio-belitzky <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>
  </>
)}
{route === 'notFound' && (
  <section class="page-intro">
    <p class="eyebrow">404</p>
    <h1>{copy.notFound}</h1>
    <p>{copy.notFoundText}</p>
    <ActionLink href={routePath(locale, 'home')}>{copy.home}</ActionLink>
    {locale === 'en' && (
      <p class="notice subheading">
        <a href="/es/404/" lang="es">
          Ver esta página en español
        </a>
      </p>
    )}
  </section>
)}
