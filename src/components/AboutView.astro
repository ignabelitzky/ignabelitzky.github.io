---
import { dacor, experiencePeriod } from '../data/experience.ts';
import { detailPath } from '../i18n/routes.ts';
import { ui } from '../i18n/ui.ts';
import { editorial } from '../i18n/editorial.ts';
import { site, availableCV } from '../data/site.ts';
import type { Locale } from '../i18n/routes.ts';
import ResearchCallout from './ResearchCallout.astro';
import ContactStrip from './ContactStrip.astro';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy = editorial[locale];
const cv = availableCV(locale);
---

<section class="page-intro">
  <p class="eyebrow">
    {site.title} · {site.location}
  </p>
  <h1>{ui[locale].titles.about}</h1>
</section>
<div class="about-content">
  <section class="prose biography">
    {copy.bioFull.map((paragraph) => (
      <p>{paragraph}</p>
    ))}
  </section>
  <section class="section">
    <h2>{copy.tech}</h2>
    <dl class="technology-groups">
      {copy.technologyGroups.map(([area, technologies]) => (
        <div>
          <dt>{area}</dt>
          <dd>{technologies}</dd>
        </div>
      ))}
    </dl>
  </section>
  <section class="section">
    <h2>{ui[locale].interests}</h2>
    <ul class="interest-list">
      {ui[locale].interestItems.map((item) => (
        <li>{item}</li>
      ))}
    </ul>
  </section>
  <section class="section" id="dacor">
    <h2>{copy.practical}</h2>
    <p class="eyebrow">{experiencePeriod(locale)}</p>
    <h3>{dacor.translations[locale].title}</h3>
    <p class="muted">{dacor.translations[locale].text}</p>
    <ul class="responsibilities">
      {dacor.translations[locale].responsibilities.map((item) => (
        <li>{item}</li>
      ))}
    </ul>
    <div class="actions">
      <a class="text-link" href={detailPath(locale, 'projects', dacor.caseStudySlug)}>
        {copy.detail} <span aria-hidden="true">→</span>
      </a>
      <a class="text-link" href={dacor.website}>
        {ui[locale].visitWebsite} <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
  <section class="section" id="research">
    <h2>{copy.research}</h2>
    <ResearchCallout locale={locale} />
  </section>
  {cv && (
    <a class="text-link" href={cv.path} download>
      {cv.label}
    </a>
  )}
</div>
<ContactStrip locale={locale} />
