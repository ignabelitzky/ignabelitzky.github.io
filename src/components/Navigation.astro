---
import { ui } from '../i18n/ui.ts';
import {
  isCurrent,
  routePath,
  type CoreRoute,
  type Locale,
  type RouteKey,
} from '../i18n/routes.ts';
interface Props {
  locale: Locale;
  route: RouteKey;
  mobile?: boolean;
  showWriting: boolean;
}
const { locale, route, mobile = false, showWriting } = Astro.props;
const copy = ui[locale];
const items: CoreRoute[] = [
  'home',
  'projects',
  'about',
  ...(showWriting ? ['writing' as const] : []),
  'contact',
];
---

<nav
  class:list={[mobile ? 'mobile-nav' : 'nav']}
  aria-label={mobile ? copy.mobileNav : copy.mainNav}
>
  {items.map((item) => (
    <a
      href={routePath(locale, item)}
      aria-current={isCurrent(route, item) ? (route === item ? 'page' : 'location') : undefined}
    >
      {copy.nav[item]}
    </a>
  ))}
</nav>
