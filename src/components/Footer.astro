---
import { site } from '../data/site.ts';
import { ui } from '../i18n/ui.ts';
import { routePath, type Locale } from '../i18n/routes.ts';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<footer>
  <div class="wrap footer">
    <span>
      © <span data-copyright-year>{new Date().getFullYear()}</span> {site.name}
      · {site.location}
    </span>
    <div class="footer-links">
      <a href={site.github}>GitHub</a>
      <a href={site.linkedin}>LinkedIn</a>
      <a href={routePath(locale, 'contact')}>{ui[locale].nav.contact}</a>
      <a href="/" data-cookie-settings>
        {ui[locale].cookies.settings}
      </a>
    </div>
  </div>
</footer>

<!-- Refresh cached static HTML without requests, timers or a yearly rebuild. -->
<script is:inline>
  (() => {
    const updateYear = () => {
      const year = String(new Date().getFullYear());
      document.querySelectorAll('[data-copyright-year]').forEach((element) => {
        element.textContent = year;
      });
    };

    updateYear();
    window.addEventListener('pageshow', updateYear);
    document.addEventListener('visibilitychange', () => {
      if (!document.hidden) updateYear();
    });
  })();
</script>
