---
import type { Locale } from '../i18n/routes.ts';
import { ui } from '../i18n/ui.ts';
interface Props {
  locale: Locale;
  measurementId: string;
}
const { locale, measurementId } = Astro.props;
const copy = ui[locale].cookies;
---

<aside
  class="consent"
  data-consent
  hidden
  aria-labelledby="consent-title"
  aria-describedby="consent-description"
  data-measurement-id={measurementId}
>
  <div class="consent-inner">
    <div class="consent-copy">
      <h2 id="consent-title">{copy.title}</h2>
      <p id="consent-description">{copy.description}</p>
      <details class="consent-details">
        <summary>{copy.detailsLabel}</summary>
        <p>{copy.details}</p>
      </details>
    </div>
    <div class="consent-actions">
      <button type="button" class="consent-button consent-accept" data-consent-choice="accepted">
        {copy.accept}
      </button>
      <button type="button" class="consent-button consent-reject" data-consent-choice="rejected">
        {copy.reject}
      </button>
    </div>
  </div>
</aside>

<script>
  import { analyticsConsentKey, readConsent, writeConsent } from '../lib/analytics-consent';

  const panel = document.querySelector<HTMLElement>('[data-consent]');
  if (panel) {
    const consentPanel: HTMLElement = panel;
    const analyticsWindow = window as unknown as Window & {
      dataLayer?: unknown[];
      gtag?: (...args: unknown[]) => void;
      [key: `ga-disable-${string}`]: boolean | undefined;
    };
    const measurementId = consentPanel.dataset.measurementId ?? '';
    let initialized = false;
    let openingControl: HTMLElement | null = null;
    let reloadTimer: number | undefined;

    function removeAnalyticsCookies() {
      for (const cookie of document.cookie.split(';')) {
        const name = cookie.split('=')[0]?.trim();
        if (!name || !/^(_ga(?:_|$)|_gid$|_gat(?:_|$))/.test(name)) continue;
        const host = location.hostname;
        const domains = [host, `.${host}`];
        for (const domain of domains) {
          document.cookie = `${name}=; Max-Age=0; path=/; domain=${domain}; SameSite=Lax`;
        }
        document.cookie = `${name}=; Max-Age=0; path=/; SameSite=Lax`;
      }
    }

    function stopAnalytics() {
      if (!initialized) return;
      analyticsWindow[`ga-disable-${measurementId}`] = true;
      removeAnalyticsCookies();
      if (reloadTimer) window.clearTimeout(reloadTimer);
      reloadTimer = window.setTimeout(() => location.reload(), 120);
    }

    function startAnalytics() {
      if (initialized || !measurementId || analyticsWindow[`ga-disable-${measurementId}`]) return;
      initialized = true;
      analyticsWindow.dataLayer = analyticsWindow.dataLayer || [];
      analyticsWindow.gtag = function gtag(...args: unknown[]) {
        analyticsWindow.dataLayer?.push(args);
      };
      analyticsWindow.gtag('js', new Date());
      analyticsWindow.gtag('config', measurementId, {
        allow_google_signals: false,
        allow_ad_personalization_signals: false,
      });
      const script = document.createElement('script');
      script.async = true;
      script.src = `https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(measurementId)}`;
      script.dataset.analytics = 'consented';
      document.head.append(script);
    }

    function show(focus = false) {
      consentPanel.hidden = false;
      if (focus) consentPanel.querySelector<HTMLButtonElement>('[data-consent-choice]')?.focus();
    }

    function hide(restoreFocus = false) {
      consentPanel.hidden = true;
      if (restoreFocus) openingControl?.focus();
    }

    function synchronize(value: unknown) {
      if (value === 'accepted') startAnalytics();
      else if (value === 'rejected') stopAnalytics();
      show();
    }

    let safeStorage: Storage | null = null;
    try {
      safeStorage = window.localStorage;
    } catch {
      /* Consent stays opt-in for this visit. */
    }
    const consent = () => (safeStorage ? readConsent(safeStorage) : null);
    const persist = (choice: 'accepted' | 'rejected') =>
      safeStorage ? writeConsent(safeStorage, choice) : false;
    const current = consent();
    if (current === 'accepted') startAnalytics();
    else if (!current) show();

    consentPanel.querySelectorAll<HTMLButtonElement>('[data-consent-choice]').forEach((button) => {
      button.addEventListener('click', () => {
        const choice = button.dataset.consentChoice;
        if (choice !== 'accepted' && choice !== 'rejected') return;
        const previous = consent();
        persist(choice);
        if (choice === 'accepted') startAnalytics();
        else if (previous === 'accepted') {
          stopAnalytics();
          removeAnalyticsCookies();
        }
        hide(true);
      });
    });

    document.querySelectorAll<HTMLAnchorElement>('[data-cookie-settings]').forEach((link) => {
      link.addEventListener('click', (event) => {
        event.preventDefault();
        openingControl = link;
        show(true);
      });
    });

    window.addEventListener('storage', (event) => {
      if (event.key === analyticsConsentKey) synchronize(event.newValue);
    });
  }
</script>
