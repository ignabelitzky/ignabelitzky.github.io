---
import { getImage } from 'astro:assets';
import preview from '../assets/social-preview.png';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site.ts';
import { ui } from '../i18n/ui.ts';
import { routePath, otherLocale, type Locale, type RouteKey } from '../i18n/routes.ts';
import '../styles/global.css';
interface Props {
  locale: Locale;
  route: RouteKey;
  title?: string;
  description?: string;
  noindex?: boolean;
  alternates?: Partial<Record<Locale, string>>;
  article?: { published: Date; updated?: Date };
}
const { locale, route, title, description, noindex = false, article } = Astro.props;
const is404 = route === 'notFound';
const section = route === 'project' ? 'projects' : route === 'article' ? 'writing' : route;
const pageTitle =
  title ?? (section === 'notFound' ? ui[locale].notFound : ui[locale].titles[section]);
const fullTitle = route === 'home' ? pageTitle : `${pageTitle} — ${site.name}`;
const summary =
  description ??
  (section === 'notFound' ? ui[locale].notFoundText : ui[locale].descriptions[section]);
const origin = Astro.site ?? new URL(site.origin);
const canonical = new URL(Astro.url.pathname, origin);
const alternates = Astro.props.alternates ?? {
  en: routePath('en', route),
  es: routePath('es', route),
};
const languagePath = alternates[otherLocale(locale)] ?? routePath(otherLocale(locale), 'home');
const social = await getImage({ src: preview, format: 'png', width: 1200, height: 630 });
const imageUrl = new URL(social.src, origin);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{fullTitle}</title>
    <meta name="description" content={summary} />
    <meta
      name="robots"
      content={!site.indexable || noindex || is404 ? 'noindex, nofollow' : 'index, follow'}
    />
    {!is404 && (
      <>
        <link rel="canonical" href={canonical} />
        {Object.entries(alternates).map(([lang, path]) => (
          <link rel="alternate" hreflang={lang} href={new URL(path, origin)} />
        ))}
        <link
          rel="alternate"
          hreflang="x-default"
          href={new URL(alternates.en ?? alternates.es ?? routePath('en', 'home'), origin)}
        />
      </>
    )}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    {article && (
      <>
        <meta property="article:published_time" content={article.published.toISOString()} />
        {article.updated && (
          <meta property="article:modified_time" content={article.updated.toISOString()} />
        )}
        <meta name="author" content={site.name} />
      </>
    )}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={summary} />
    <meta property="og:locale" content={locale === 'es' ? 'es_AR' : 'en_US'} />
    {alternates[otherLocale(locale)] && (
      <meta property="og:locale:alternate" content={locale === 'es' ? 'en_US' : 'es_AR'} />
    )}
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name} — ${site.title}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={summary} />
    <meta name="twitter:image" content={imageUrl} />
    <script is:inline>
      // Run before CSS paints. System follows the OS without a persisted override.
      try {
        const value = localStorage.getItem('ib-theme');
        if (value === 'light' || value === 'dark') document.documentElement.dataset.theme = value;
      } catch {
        /* OS-aware CSS remains usable when storage is unavailable. */
      }
    </script>
  </head>
  <body>
    <a class="skip" href="#main">
      {ui[locale].skip}
    </a>
    <Header locale={locale} route={route} languagePath={languagePath} />
    <main id="main" tabindex="-1" class="wrap">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
